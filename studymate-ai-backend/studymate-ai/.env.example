# --- LLM Provider ---
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq              # groq | ollama
LLM_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_PERSIST_DIR=./storage/chroma
CHROMA_COLLECTION_NAME=studymate_docs

# --- SQLite (sessions/history) ---
SQLITE_DB_PATH=./storage/studymate.db

# --- Retrieval ---
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.35
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# --- App ---
ENVIRONMENT=development        # development | production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
INGESTED_DOCS_DIR=./ingested_docs
MAX_UPLOAD_SIZE_MB=25

# --- Rate limiting ---
RATE_LIMIT_QA=10/minute
RATE_LIMIT_INGEST=5/minute
RATE_LIMIT_DEFAULT=60/minute

# --- Cache ---
RESPONSE_CACHE_SIZE=256
